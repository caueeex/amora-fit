# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA faça commit do .env.local.

# --- Públicas (vão para o navegador) ---------------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...) ou a chave legada "anon". Protegida por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# URL pública do site (usada em links de e-mail de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor (NUNCA prefixar com NEXT_PUBLIC_) --------------------
# Chave "secret" (sb_secret_...) ou a legada "service_role".
# Usada apenas por scripts administrativos locais (ex.: promover o primeiro admin).
# Não é necessária na Vercel.
SUPABASE_SECRET_KEY=
